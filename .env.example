# 이 파일을 복사해서 .env 로 만들고 실제 키를 넣으세요. (.env 는 절대 커밋 금지)
GEMINI_API_KEY=여기에_키_입력
# AI Studio에서 현재 사용 가능한 Flash 계열 모델 이름을 확인해서 넣으세요
GEMINI_MODEL=gemini-flash-latest
# =========================================================
# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.
# 값은 = 뒤에 띄어쓰기 없이 입력하세요.  예) NAVER_CLIENT_ID=abc123
# =========================================================

# ---------------------------------------------------------
# [price] 환율 API  (담당: B)
# 9주차에 선택한 API에 맞게 수정 → docs/exchange_api.md 참고
# 키가 필요 없는 API를 선택하면 비워 두거나 삭제
# ---------------------------------------------------------
EXCHANGE_RATE_API_KEY=

# ---------------------------------------------------------
# [search] 네이버 쇼핑 검색 API  (담당: C)
# 네이버 개발자센터 > Application 등록 후 발급
# ---------------------------------------------------------
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

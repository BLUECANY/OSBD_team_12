# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 실제 값을 채우세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.
# 값은 = 뒤에 띄어쓰기 없이 입력하세요.

# [price] 환율 API (담당: B)
# 키가 필요 없는 API를 선택하면 비워 두거나 삭제
EXCHANGE_RATE_API_KEY=

# [search] 상품 검색 (담당: C)
# SerpApi 키: serpapi.com 가입 후 발급 (무료 월 250회)
SERPAPI_API_KEY=
# Gemini 키(동일/대체 상품 분류용): Google AI Studio에서 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
